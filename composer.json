{
  "name": "caremillc/caremi",
  "description": "Caremi application powered by the Careminate framework.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "caremillc/framework": "0.3.0-dev"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "repositories": [
    {
      "type": "path",
      "url": "framework",
      "options": {
        "reference": "config",
        "versions": {
          "caremillc/framework": "0.3.0-dev"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Careminate\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist",
    "check": [
      "@test"
    ]
  },
  "config": {
    "allow-plugins": false,
    "optimize-autoloader": true,
    "platform-check": true,
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
