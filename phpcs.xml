<?xml version="1.0"?>
<ruleset name="Careminate Workspace">
    <description>
        Coding standard for the Careminate reference application and framework workspace.
    </description>

    <file>app</file>
    <file>bootstrap</file>
    <file>config</file>
    <file>modules</file>
    <file>routes</file>
    <file>tests</file>
    <file>framework/src</file>
    <file>framework/tests</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>
</ruleset>