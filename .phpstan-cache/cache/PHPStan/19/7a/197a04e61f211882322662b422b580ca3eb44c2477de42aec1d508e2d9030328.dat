 * Creates a new lazy proxy instance
 *
 * Creates a new lazy proxy instance of the class, attaching the factory function to it. The
 * constructor is not called, and properties are not set to their default values. When an
 * attempt is made to observe or modify the proxy's state for the first time, the factory
 * function is called to provide a real instance, which is then attached to the proxy. After
 * this, all subsequent interactions with the proxy are forwarded to the real instance. See
 * Initialization Triggers and Initialization Sequence.
 *
 * @link https://php.net/manual/en/reflectionclass.newlazyproxy.php
 * @return T Returns a lazy proxy instance. If the object has no properties, or if all its
 * properties are static or virtual, a normal (non-lazy) instance is returned. See also
 * Lifecycle of Lazy Objects.
 * @since 8.4
 */";s:9:"startLine";i:872;s:7:"endLine";i:874;s:11:"startColumn";i:9;s:9:"endColumn";i:9;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";N;s:18:"declaringClassName";s:15:"ReflectionClass";s:21:"implementingClassName";s:15:"ReflectionClass";s:16:"currentClassName";s:15:"ReflectionClass";s:9:"aliasName";N;}s:16:"resetAsLazyGhost";a:20:{s:4:"name";s:16:"resetAsLazyGhost";s:10:"parameters";a:3:{s:6:"object";a:14:{s:4:"name";s:6:"object";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"object";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:886;s:7:"endLine";i:886;s:11:"startColumn";i:42;s:9:"endColumn";i:55;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:11:"initializer";a:14:{s:4:"name";s:11:"initializer";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:8:"callable";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:886;s:7:"endLine";i:886;s:11:"startColumn";i:58;s:9:"endColumn";i:78;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}s:7:"options";a:14:{s:4:"name";s:7:"options";s:7:"default";a:2:{s:4:"code";s:1:"0";s:10:"attributes";a:6:{s:9:"startLine";i:886;s:7:"endLine";i:886;s:13:"startTokenPos";i:2091;s:12:"startFilePos";i:35887;s:11:"endTokenPos";i:2091;s:10:"endFilePos";i:35887;}}s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:886;s:7:"endLine";i:886;s:11:"startColumn";i:81;s:9:"endColumn";i:96;s